{
  "name": "@beltype/caster",
  "version": "0.1.4",
  "description": "Caster, BelType's browser-side PDF 2.0 / PDF/UA-2 printer over an engine's presented pages: a DOM walk, Range measurement, HarfBuzz shaping and subsetting, vector painting, exact CMYK and spot colour, a structure tree, all inside the tab.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BelType/caster.git"
  },
  "homepage": "https://codeberg.org/BelType/caster",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./display-list": {
      "types": "./dist/src/displayList.d.ts",
      "import": "./dist/src/displayList.js"
    },
    "./internal/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.capabilities.json && node scripts/rewrite-specifiers.js dist/src/capabilities.js && node scripts/copy-assets.js",
    "check": "tsc -p tsconfig.test.json",
    "test": "node --test 'test/*.test.ts'",
    "bundle-vendor": "node scripts/bundle-vendor.js",
    "prepare": "pnpm run build",
    "identity": "node scripts/identity.ts"
  },
  "dependencies": {
    "@beltype/common": "0.1.1"
  },
  "devDependencies": {
    "@beltype/cicero": "0.1.4",
    "@beltype/specimens": "0.1.0",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "fast-png": "8.0.0",
    "fontkit": "2.0.4",
    "harfbuzzjs": "1.6.1",
    "lcms-wasm": "1.0.5",
    "mupdf": "1.28.1",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "wawoff2": "^2.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/common",
      "@beltype/cicero"
    ]
  },
  "bugs": {
    "url": "https://codeberg.org/BelType/caster/issues"
  }
}
